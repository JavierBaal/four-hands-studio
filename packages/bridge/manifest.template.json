{
  "manifest_version": "0.3",
  "name": "fourhands-mcp",
  "display_name": "Four Hands Studio",
  "version": "__VERSION__",
  "description": "Connect your AI with the score open in Four Hands Studio.",
  "long_description": "The Four Hands Studio bridge for Claude Desktop. It talks to the app open on this computer over a local WebSocket (127.0.0.1) with a token. It sends nothing to the internet.",
  "author": { "name": "Fran Barbero" },
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "server/index.mjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/index.mjs"]
    }
  },
  "tools": "__TOOLS__",
  "prompts": "__PROMPTS__",
  "keywords": ["music", "midi", "composition", "piano roll"],
  "license": "MIT",
  "homepage": "https://github.com/JavierBaal/four-hands-studio",
  "repository": { "type": "git", "url": "https://github.com/JavierBaal/four-hands-studio" },
  "compatibility": {
    "platforms": ["win32", "darwin"],
    "runtimes": { "node": ">=18.0.0" }
  }
}
